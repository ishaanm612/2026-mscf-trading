# Local RIT practice settings. Copy to .env and replace placeholders.
# .env is ignored by Git; never put credentials in source files.
# The runner selects the matching RIT_<CASE>_* settings automatically.
RIT_VOLATILITY_API_MODE=dma
RIT_VOLATILITY_API_URL=http://flserver.rotman.utoronto.ca:16595/v1
RIT_VOLATILITY_USERNAME=your-volatility-trader-id
RIT_VOLATILITY_PASSWORD=your-volatility-password

RIT_ETF_API_MODE=dma
RIT_ETF_API_URL=http://flserver.rotman.utoronto.ca:16635/v1
RIT_ETF_USERNAME=your-etf-trader-id
RIT_ETF_PASSWORD=your-etf-password
